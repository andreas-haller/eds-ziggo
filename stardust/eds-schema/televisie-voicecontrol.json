   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Inspiratie nodig?"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Met hulp van AI krijg je tips voor films, series en documentaires waarvan je niet eens wist dat je ze zocht."
    },
    {
     "role": "body",
     "order": 2,
     "text": "“Ik zoek een film die me laat huilen van het lachen.”"
    },
    {
     "role": "body",
     "order": 3,
     "text": "“Welke serie heeft er superhelden?”"
    },
    {
     "role": "body",
     "order": 4,
     "text": "“Ik zoek een serie die zich in New York afspeelt.”"
    },
    {
     "role": "body",
     "order": 5,
     "text": "“Ik heb zin in een hele goede serie met veel actie.”"
    },
    {
     "role": "body",
     "order": 6,
     "text": "“Welke sportprogramma’s zijn er vanavond te zien?”"
    },
    {
     "role": "body",
     "order": 7,
     "text": "“Ik heb zin in een film om bij weg te zwijmelen.\""
    }
   ],
